# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Axiom (Logging)
NEXT_PUBLIC_AXIOM_TOKEN=your-axiom-token
NEXT_PUBLIC_AXIOM_DATASET=frontend
AXIOM_TOKEN=your-axiom-token
AXIOM_DATASET=backend

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# E2E Testing (optional)
E2E_STUDENT_EMAIL=e2e_student@example.com
E2E_STUDENT_PASSWORD=test-password
E2E_PROFESSOR_EMAIL=e2e_professor@example.com
E2E_PROFESSOR_PASSWORD=test-password
E2E_ADMIN_EMAIL=e2e_admin@example.com
E2E_ADMIN_PASSWORD=test-password
BASE_URL=http://localhost:3000
